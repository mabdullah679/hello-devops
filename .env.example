# Local development only. Copy to .env (git-ignored) and fill in. In AWS these
# come from the ECS task definition / SSM Parameter Store, never from a file.
PORT=8080
LOG_LEVEL=INFO
# Bearer token for POST/GET /admin/chaos. Leave empty to disable the admin API.
ADMIN_TOKEN=
# Unset = chaos flag kept in process memory. In AWS: SSM parameter name.
CHAOS_SSM_PARAM=
APP_VERSION=dev
DRAIN_SECONDS=5
