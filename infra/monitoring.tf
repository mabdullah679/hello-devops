resource "aws_sns_topic" "alerts" {
  name = "${var.name_prefix}-alerts"
}

resource "aws_sns_topic_subscription" "email" {
  count     = var.alert_email == "" ? 0 : 1
  topic_arn = aws_sns_topic.alerts.arn
  protocol  = "email"
  endpoint  = var.alert_email
}

locals {
  lb_dim = aws_lb.main.arn_suffix
  tg_dim = aws_lb_target_group.app.arn_suffix
}

# 5xx served to users: the app's own 5xx plus 5xx generated by the ALB itself
# (e.g. 502/503 when no healthy target exists). FILL(...,0) so quiet minutes are 0.
resource "aws_cloudwatch_metric_alarm" "http_5xx" {
  alarm_name          = "${var.name_prefix}-5xx"
  alarm_description   = "Any 5xx served by the ALB or its targets in 1 minute"
  comparison_operator = "GreaterThanOrEqualToThreshold"
  threshold           = 1
  evaluation_periods  = 1
  treat_missing_data  = "notBreaching"
  alarm_actions       = [aws_sns_topic.alerts.arn]
  ok_actions          = [aws_sns_topic.alerts.arn]

  metric_query {
    id          = "total"
    expression  = "FILL(t,0)+FILL(e,0)"
    label       = "5xx total"
    return_data = true
  }
  metric_query {
    id = "t"
    metric {
      namespace   = "AWS/ApplicationELB"
      metric_name = "HTTPCode_Target_5XX_Count"
      period      = 60
      stat        = "Sum"
      dimensions  = { LoadBalancer = local.lb_dim, TargetGroup = local.tg_dim }
    }
  }
  metric_query {
    id = "e"
    metric {
      namespace   = "AWS/ApplicationELB"
      metric_name = "HTTPCode_ELB_5XX_Count"
      period      = 60
      stat        = "Sum"
      dimensions  = { LoadBalancer = local.lb_dim }
    }
  }
}

resource "aws_cloudwatch_metric_alarm" "unhealthy_hosts" {
  alarm_name          = "${var.name_prefix}-unhealthy-targets"
  alarm_description   = "At least one target failing the ALB health check (/readyz)"
  namespace           = "AWS/ApplicationELB"
  metric_name         = "UnHealthyHostCount"
  dimensions          = { LoadBalancer = local.lb_dim, TargetGroup = local.tg_dim }
  statistic           = "Maximum"
  period              = 60
  evaluation_periods  = 1
  threshold           = 1
  comparison_operator = "GreaterThanOrEqualToThreshold"
  treat_missing_data  = "notBreaching"
  alarm_actions       = [aws_sns_topic.alerts.arn]
  ok_actions          = [aws_sns_topic.alerts.arn]
}

# ---- Synthetic check ------------------------------------------------------------
data "archive_file" "synthetic" {
  type        = "zip"
  source_file = "${path.module}/lambda/synthetic.py"
  output_path = "${path.module}/.build/synthetic.zip"
}

resource "aws_cloudwatch_log_group" "synthetic" {
  name              = "/aws/lambda/${var.name_prefix}-synthetic"
  retention_in_days = 7
}

data "aws_iam_policy_document" "lambda_trust" {
  statement {
    actions = ["sts:AssumeRole"]
    principals {
      type        = "Service"
      identifiers = ["lambda.amazonaws.com"]
    }
  }
}

resource "aws_iam_role" "synthetic" {
  name                 = "${var.name_prefix}-synthetic"
  assume_role_policy   = data.aws_iam_policy_document.lambda_trust.json
  permissions_boundary = data.aws_iam_policy.boundary.arn
}

resource "aws_iam_role_policy" "synthetic" {
  name = "logs-and-metrics"
  role = aws_iam_role.synthetic.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect   = "Allow"
        Action   = ["logs:CreateLogStream", "logs:PutLogEvents"]
        Resource = "${aws_cloudwatch_log_group.synthetic.arn}:*"
      },
      {
        Effect    = "Allow"
        Action    = ["cloudwatch:PutMetricData"]
        Resource  = "*"
        Condition = { StringEquals = { "cloudwatch:namespace" = "${var.name_prefix}/Synthetic" } }
      }
    ]
  })
}

resource "aws_lambda_function" "synthetic" {
  function_name    = "${var.name_prefix}-synthetic"
  role             = aws_iam_role.synthetic.arn
  runtime          = "python3.13"
  handler          = "synthetic.handler"
  filename         = data.archive_file.synthetic.output_path
  source_code_hash = data.archive_file.synthetic.output_base64sha256
  timeout          = 15
  memory_size      = 128

  environment {
    variables = {
      TARGET_URL       = "http://${aws_lb.main.dns_name}"
      MATCH_TEXT       = "\"status\": \"ok\""
      TIMEOUT_SECONDS  = "5"
      METRIC_NAMESPACE = "${var.name_prefix}/Synthetic"
    }
  }
  depends_on = [aws_cloudwatch_log_group.synthetic, aws_iam_role_policy.synthetic]
}

resource "aws_cloudwatch_event_rule" "synthetic" {
  name                = "${var.name_prefix}-synthetic-every-minute"
  schedule_expression = "rate(1 minute)"
}

resource "aws_cloudwatch_event_target" "synthetic" {
  rule = aws_cloudwatch_event_rule.synthetic.name
  arn  = aws_lambda_function.synthetic.arn
}

resource "aws_lambda_permission" "synthetic" {
  statement_id  = "AllowEventBridge"
  action        = "lambda:InvokeFunction"
  function_name = aws_lambda_function.synthetic.function_name
  principal     = "events.amazonaws.com"
  source_arn    = aws_cloudwatch_event_rule.synthetic.arn
}

# Down = Up metric below 1 for 2 consecutive minutes. Missing data counts as
# breaching: if the check itself stops reporting, silence must not look like success.
resource "aws_cloudwatch_metric_alarm" "synthetic_down" {
  alarm_name          = "${var.name_prefix}-synthetic-down"
  alarm_description   = "Synthetic /healthz check failed (non-200, content mismatch, timeout) or stopped reporting"
  namespace           = "${var.name_prefix}/Synthetic"
  metric_name         = "Up"
  statistic           = "Minimum"
  period              = 60
  evaluation_periods  = 2
  datapoints_to_alarm = 2
  threshold           = 1
  comparison_operator = "LessThanThreshold"
  treat_missing_data  = "breaching"
  alarm_actions       = [aws_sns_topic.alerts.arn]
  ok_actions          = [aws_sns_topic.alerts.arn]
}
